{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csiiiv/OCR-Lexer/schemas/spatial-anchor.schema.json",
  "title": "SpatialAnchorHypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "page_id", "kind", "intercept", "slope", "residual_scale", "support_object_ids", "score", "evidence"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "page_id": {"type": "integer", "minimum": 0},
    "kind": {
      "type": "string",
      "enum": ["LEFT_TEXT", "RIGHT_TEXT", "RIGHT_NUMERIC", "DECIMAL", "BASELINE"]
    },
    "intercept": {"type": "number"},
    "slope": {"type": "number"},
    "residual_scale": {"type": "number", "exclusiveMinimum": 0},
    "support_object_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "score": {"type": "number"},
    "evidence": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    }
  }
}
